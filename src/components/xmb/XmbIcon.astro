---
import game from '@phosphor-icons/core/assets/fill/game-controller-fill.svg?raw';
import trophy from '@phosphor-icons/core/assets/fill/trophy-fill.svg?raw';
import toolbox from '@phosphor-icons/core/assets/fill/toolbox-fill.svg?raw';
import player from '@phosphor-icons/core/assets/fill/user-circle-fill.svg?raw';
import play from '@phosphor-icons/core/assets/fill/play-circle-fill.svg?raw';
import sound from '@phosphor-icons/core/assets/fill/speaker-high-fill.svg?raw';
import muted from '@phosphor-icons/core/assets/fill/speaker-slash-fill.svg?raw';
import volume from '@phosphor-icons/core/assets/fill/sliders-horizontal-fill.svg?raw';
import power from '@phosphor-icons/core/assets/fill/power-fill.svg?raw';
import history from '@phosphor-icons/core/assets/fill/clock-counter-clockwise-fill.svg?raw';
import share from '@phosphor-icons/core/assets/fill/share-network-fill.svg?raw';
import palette from '@phosphor-icons/core/assets/fill/palette-fill.svg?raw';

const icons = { game, trophy, toolbox, player, play, sound, muted, volume, power, history, share, palette };
interface Props {
	name: keyof typeof icons;
	class?: string;
}
const { name, class: className } = Astro.props;
---

<span class:list={['xmb-glyph', className]} aria-hidden="true" set:html={icons[name]} />

<style>
	.xmb-glyph { display: inline-flex; width: 100%; height: 100%; align-items: center; justify-content: center; }
	.xmb-glyph :global(svg) { display: block; width: 100%; height: 100%; fill: currentColor; }
</style>
