		content: "";
		position: absolute;
		inset: -1rem;
		border-radius: 50%;
		background: radial-gradient(ellipse, color-mix(in srgb, var(--theme-light) 28%, transparent), transparent 68%);
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.xmb-icon :global(.xmb-glyph) {
		position: relative;
		-webkit-mask-image: linear-gradient(#000 25%, rgba(0, 0, 0, 0.88));
		mask-image: linear-gradient(#000 25%, rgba(0, 0, 0, 0.88));
	}
	.xmb-label {
		font-size: 0.875rem;
		font-weight: 300;
		color: var(--muted);
		transform: translateY(0);
		transition: opacity 0.3s ease, transform 0.3s var(--ease);
