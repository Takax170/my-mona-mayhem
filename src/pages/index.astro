---
import BootScreen from '../components/xmb/BootScreen.astro';
import WaveBackground from '../components/xmb/WaveBackground.astro';
import XmbIcon from '../components/xmb/XmbIcon.astro';
import { defaultSettings, SETTINGS_KEY, themePresets } from '../lib/xmb-settings';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1d5aa6" />
		<script is:inline define:vars={{ settingsKey: SETTINGS_KEY }}>
			try {
				const color = JSON.parse(localStorage.getItem(settingsKey) || '{}')?.themeColor;
				if (typeof color === 'string' && color.length === 7 && /^#[0-9a-f]{6}$/i.test(color)) {
					document.documentElement.style.setProperty('--theme-color', color);
					document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
				}
			} catch {}
		</script>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Compare the GitHub contributions of two players." />
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<div class="handheld">
			<div id="app" class="screen">
				<WaveBackground />
				<BootScreen />
				<div class="screen-content">
					<header class="system-bar">
						<h1>Mona Mayhem <span class="subtitle">GitHub Contribution Battle Arena</span></h1>
						<div class="system-info">
							<time id="clock" aria-hidden="true"></time>
							<button id="sound-quick" class="sound-quick" type="button" aria-pressed="true" aria-label="Sound effects">
								<XmbIcon name="sound" class="sound-wave" />
								<XmbIcon name="muted" class="sound-off" />
							</button>
						</div>
					</header>

					<main>
						<nav class="xmb-bar" aria-label="Main menu">
							<div class="xmb-track" role="tablist" aria-label="Main menu">
								<button id="tab-battle" class="xmb-category" role="tab" type="button" aria-selected="true" aria-controls="panel-battle" tabindex="0">
									<span class="xmb-icon"><XmbIcon name="game" /></span>
									<span class="xmb-label">Battle</span>
								</button>
								<button id="tab-results" class="xmb-category" role="tab" type="button" aria-selected="false" aria-controls="battle-results" tabindex="-1">
									<span class="xmb-icon"><XmbIcon name="trophy" /></span>
									<span class="xmb-label">Results</span>
								</button>
								<button id="tab-settings" class="xmb-category" role="tab" type="button" aria-selected="false" aria-controls="panel-settings" tabindex="-1">
									<span class="xmb-icon"><XmbIcon name="toolbox" /></span>
									<span class="xmb-label">Settings</span>
								</button>
								<button id="tab-history" class="xmb-category" role="tab" type="button" aria-selected="false" aria-controls="panel-history" tabindex="-1">
									<span class="xmb-icon"><XmbIcon name="history" /></span>
									<span class="xmb-label">History</span>
								</button>
							</div>
						</nav>

						<div class="xmb-panels">
							<section id="panel-battle" class="xmb-panel" role="tabpanel" aria-labelledby="tab-battle">
								<form id="battle-form" novalidate>
									<div class="xmb-item" data-selected="true">
										<span class="item-icon"><XmbIcon name="player" /></span>
										<div class="item-body field">
											<label for="player-1">Player 1</label>
											<div class="username-combobox">
												<input id="player-1" name="player1" type="text" value="Moussandou" placeholder="Moussandou"
													required maxlength="39" autocomplete="off" autocapitalize="none"
													spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false"
													aria-controls="player-1-suggestions" aria-describedby="player-1-help player-1-error" />
												<div id="player-1-menu" class="username-menu" hidden>
													<ul id="player-1-suggestions" class="username-suggestions" role="listbox" aria-label="Player 1 GitHub suggestions" hidden></ul>
													<p id="player-1-search-status" class="help search-status" role="status" aria-live="polite"></p>
												</div>
											</div>
											<p id="player-1-help" class="help">Enter a GitHub username. Suggestions appear after 2 characters.</p>
											<p id="player-1-error" class="error" hidden></p>
										</div>
									</div>
									<div class="xmb-item">
										<span class="item-icon"><XmbIcon name="player" /></span>
										<div class="item-body field">
											<label for="player-2">Player 2</label>
											<div class="username-combobox">
												<input id="player-2" name="player2" type="text" value="justinyoo" placeholder="justinyoo"
													required maxlength="39" autocomplete="off" autocapitalize="none"
													spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false"
													aria-controls="player-2-suggestions" aria-describedby="player-2-help player-2-error" />
												<div id="player-2-menu" class="username-menu" hidden>
													<ul id="player-2-suggestions" class="username-suggestions" role="listbox" aria-label="Player 2 GitHub suggestions" hidden></ul>
													<p id="player-2-search-status" class="help search-status" role="status" aria-live="polite"></p>
												</div>
											</div>
											<p id="player-2-help" class="help">Enter a GitHub username. Suggestions appear after 2 characters.</p>
											<p id="player-2-error" class="error" hidden></p>
										</div>
									</div>
									<div class="xmb-item battle-item">
										<span class="item-icon start-icon"><XmbIcon name="play" /></span>
										<div class="item-body">
											<button type="submit" class="battle-button">Start Battle</button>
											<p class="help">Compare contributions. Reveal the winner.</p>
										</div>
									</div>
								</form>
							</section>

							<section id="battle-results" class="xmb-panel" role="tabpanel" aria-labelledby="tab-results" aria-busy="false" hidden>
								<h2 id="results-title" class="panel-title">Results</h2>
								<div id="results-empty" class="empty-state">
									<span class="empty-icon"><XmbIcon name="trophy" /></span>
									<p class="muted">Enter two usernames and select Start Battle to compare their contributions.</p>
								</div>
								<div id="results-loading" class="loading" hidden>
									<div class="loader" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
									<div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
									<div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
								</div>
								<div id="results-content" class="results" hidden>
									<article id="result-1-card" class="xmb-item player-card" aria-labelledby="result-1-username">
										<span class="item-icon"><XmbIcon name="player" /></span>
										<div class="item-body">
											<p class="player-label">Player 1 <span id="result-1-badge" class="card-badge" hidden>Winner</span></p>
											<h3 id="result-1-username"></h3>
											<dl>
												<div><dt>Contributions</dt><dd id="result-1-total" class="total"></dd></div>
												<div><dt>Period</dt><dd id="result-1-period"></dd></div>
											</dl>
											<div id="result-1-graph" class="contribution-graph" tabindex="0"
												role="region" aria-label="Player 1 contribution graph"></div>
										</div>
									</article>
									<span class="vs-badge">VS</span>
									<article id="result-2-card" class="xmb-item player-card" aria-labelledby="result-2-username">
										<span class="item-icon"><XmbIcon name="player" /></span>
										<div class="item-body">
											<p class="player-label">Player 2 <span id="result-2-badge" class="card-badge" hidden>Winner</span></p>
											<h3 id="result-2-username"></h3>
											<dl>
												<div><dt>Contributions</dt><dd id="result-2-total" class="total"></dd></div>
												<div><dt>Period</dt><dd id="result-2-period"></dd></div>
											</dl>
											<div id="result-2-graph" class="contribution-graph" tabindex="0"
												role="region" aria-label="Player 2 contribution graph"></div>
										</div>
									</article>
								</div>
								<p id="battle-outcome" class="outcome" hidden></p>
								<div id="result-actions" class="result-actions xmb-item" hidden>
									<button id="share-results" class="menu-button" type="button">
										<span class="action-icon"><XmbIcon name="share" /></span>
										Share Results
									</button>
									<p id="share-feedback" class="help" role="status" aria-live="polite"></p>
								</div>
								<p id="graph-help" class="help" hidden>Totals compare each player's returned period. Hover or tap a day for details; scroll graphs horizontally to see all weeks.</p>
							</section>

							<section id="panel-settings" class="xmb-panel" role="tabpanel" aria-labelledby="tab-settings" hidden>
								<h2 class="panel-title">Settings</h2>
								<div class="xmb-item" data-selected="true">
									<span class="item-icon"><XmbIcon name="palette" /></span>
									<div class="item-body setting">
										<label for="setting-theme">Color theme</label>
										<select id="setting-theme">
											{themePresets.map((theme) => <option value={theme.color}>{theme.label}</option>)}
											<option value="custom">Custom</option>
										</select>
									</div>
								</div>
								<div class="xmb-item">
									<span class="item-icon"><XmbIcon name="palette" /></span>
									<div class="item-body">
										<div class="setting">
											<label for="setting-color">Custom color</label>
											<div class="color-control">
												<output id="theme-color-value" for="setting-color">{defaultSettings.themeColor.toUpperCase()}</output>
												<input id="setting-color" type="color" value={defaultSettings.themeColor} aria-describedby="theme-help" />
											</div>
										</div>
										<p id="theme-help" class="help">Colors update live. Brightness adjusts to keep text readable.</p>
									</div>
								</div>
								<div class="xmb-item">
									<span class="item-icon"><XmbIcon name="palette" /></span>
									<div class="item-body">
										<button id="reset-theme" class="menu-button" type="button">Restore blue theme</button>
									</div>
								</div>
								<div class="xmb-item">
									<span class="item-icon"><XmbIcon name="sound" /></span>
									<div class="item-body setting">
										<label for="setting-sound">Sound effects</label>
										<input id="setting-sound" type="checkbox" class="switch" />
									</div>
								</div>
								<div class="xmb-item">
									<span class="item-icon"><XmbIcon name="volume" /></span>
									<div class="item-body setting">
										<label for="setting-volume">Volume</label>
										<input id="setting-volume" type="range" min="0" max="100" step="5" />
									</div>
								</div>
								<div class="xmb-item">
									<span class="item-icon"><XmbIcon name="power" /></span>
									<div class="item-body setting">
										<label for="setting-boot">Startup animation</label>
										<input id="setting-boot" type="checkbox" class="switch" />
									</div>
								</div>
								<p class="help controls-help">Arrow keys navigate, Enter confirms, Escape or Backspace goes back. On touch screens, swipe left or right to change category.</p>
								<p id="settings-notice" class="error" role="status" hidden></p>
							</section>
							<section id="panel-history" class="xmb-panel" role="tabpanel" aria-labelledby="tab-history" hidden>
								<div class="history-heading">
									<h2 class="panel-title">Battle history</h2>
									<button id="clear-history" class="menu-button" type="button" hidden>Clear history</button>
								</div>
								<p class="help">Your last 20 completed battles, saved in this browser.</p>
								<p id="history-notice" class="error" role="status" hidden></p>
								<p id="history-empty" class="muted">No battles yet. Start a battle to create your first result.</p>
								<ol id="history-list" class="history-list" aria-label="Recent battles"></ol>
							</section>
						</div>

						<p id="battle-status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
						<noscript><p class="error">Enable JavaScript to compare GitHub contributions.</p></noscript>
					</main>
					<footer class="control-strip" aria-label="Keyboard controls">
						<span><kbd class="direction-key">↔</kbd> Category</span>
						<span><kbd class="direction-key">↕</kbd> Item</span>
						<span><kbd>Enter</kbd> Select</span>
						<span><kbd>Esc</kbd> Back</span>
						<span class="touch-hint">Swipe to change category</span>
					</footer>
				</div>
			</div>
		</div>
		<div id="grid-tooltip" class="grid-tooltip" aria-hidden="true" hidden></div>
	</body>
</html>

<script>
	import { battleOutcome } from '../lib/battle-outcome';
	import { contributionRows, isPlayerResult } from '../lib/contribution-grid';
	import type { PlayerResult } from '../lib/contribution-grid';
	import { getContributions } from '../lib/contributions';
	import { defaultSettings, loadSettings, saveSettings, themePresets } from '../lib/xmb-settings';
	import { createSoundPlayer } from '../lib/xmb-sound';
	import { formatBattleSummary, HISTORY_KEY, parseHistory, prependBattle } from '../lib/battle-history';
	import type { BattleRecord } from '../lib/battle-history';
	import { setupUsernameAutocomplete } from '../lib/username-autocomplete';

	function isRecord(value: unknown): value is Record<string, unknown> {
		return typeof value === 'object' && value !== null && !Array.isArray(value);
	}

	async function loadPlayer(username: string): Promise<PlayerResult> {
		if (import.meta.env.PUBLIC_GITHUB_PAGES === 'true') {
			return getContributions(username);
		}
		let response: Response;
		try {
			response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		} catch {
			throw new Error('Unable to connect. Check your connection and try again.');
		}

		let data: unknown;
		try {
			data = await response.json();
		} catch {
			throw new Error('The server returned an unreadable response. Please try again.');
		}
		if (!response.ok) {
			if (isRecord(data) && isRecord(data.error)
				&& typeof data.error.message === 'string' && data.error.message.trim()) {
				throw new Error(data.error.message);
			}
			throw new Error('Unable to load contributions. Please try again.');
		}
		if (!isPlayerResult(data)) {
			throw new Error('The server returned invalid contribution data. Please try again.');
		}
		return data;
	}

	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const status = document.querySelector<HTMLParagraphElement>('#battle-status');
	const results = document.querySelector<HTMLElement>('#battle-results');
	const empty = document.querySelector<HTMLElement>('#results-empty');
	const loadingView = document.querySelector<HTMLDivElement>('#results-loading');
	const content = document.querySelector<HTMLDivElement>('#results-content');
	const outcomeText = document.querySelector<HTMLParagraphElement>('#battle-outcome');
	const graphHelp = document.querySelector<HTMLParagraphElement>('#graph-help');
	const tooltip = document.querySelector<HTMLDivElement>('#grid-tooltip');
	const track = document.querySelector<HTMLElement>('.xmb-track');
	const clock = document.querySelector<HTMLTimeElement>('#clock');
	const soundQuick = document.querySelector<HTMLButtonElement>('#sound-quick');
	const soundSetting = document.querySelector<HTMLInputElement>('#setting-sound');
	const volumeSetting = document.querySelector<HTMLInputElement>('#setting-volume');
	const bootSetting = document.querySelector<HTMLInputElement>('#setting-boot');
	const themeSetting = document.querySelector<HTMLSelectElement>('#setting-theme');
	const colorSetting = document.querySelector<HTMLInputElement>('#setting-color');
	const colorValue = document.querySelector<HTMLOutputElement>('#theme-color-value');
	const resetTheme = document.querySelector<HTMLButtonElement>('#reset-theme');
	const settingsNotice = document.querySelector<HTMLElement>('#settings-notice');
	const historyList = document.querySelector<HTMLOListElement>('#history-list');
	const historyEmpty = document.querySelector<HTMLElement>('#history-empty');
	const historyNotice = document.querySelector<HTMLElement>('#history-notice');
	const clearHistory = document.querySelector<HTMLButtonElement>('#clear-history');
	const resultActions = document.querySelector<HTMLElement>('#result-actions');
	const shareButton = document.querySelector<HTMLButtonElement>('#share-results');
	const shareFeedback = document.querySelector<HTMLElement>('#share-feedback');
	const players = [1, 2].map((number) => {
		const input = document.querySelector<HTMLInputElement>(`#player-${number}`);
		const error = document.querySelector<HTMLParagraphElement>(`#player-${number}-error`);
		const card = document.querySelector<HTMLElement>(`#result-${number}-card`);
		const badge = document.querySelector<HTMLElement>(`#result-${number}-badge`);
		const username = document.querySelector<HTMLElement>(`#result-${number}-username`);
		const total = document.querySelector<HTMLElement>(`#result-${number}-total`);
		const period = document.querySelector<HTMLElement>(`#result-${number}-period`);
		const graph = document.querySelector<HTMLDivElement>(`#result-${number}-graph`);
		if (!input || !error || !card || !badge || !username || !total || !period || !graph) {
			throw new Error(`Player ${number} is missing required elements.`);
		}
		return { input, error, card, badge, username, total, period, graph };
	});
	const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
	const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''));
	const numberFormat = new Intl.NumberFormat('en-US');
	const dateFormat = new Intl.DateTimeFormat('en-US', {
		year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
	});
	const tooltipDate = new Intl.DateTimeFormat('en-US', {
		weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
	});
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const sounds = createSoundPlayer();
	const settings = loadSettings();
	let loading = false;
	let activeTab = 0;
	let history: BattleRecord[] = [];
	let currentBattle: BattleRecord | undefined;
	let copyTimer: ReturnType<typeof setTimeout> | undefined;

	if (!form || !button || !status || !results || !empty || !loadingView || !content || !outcomeText
		|| !graphHelp || !tooltip || !track || !clock || !soundQuick || !soundSetting || !volumeSetting
		|| !bootSetting || !historyList || !historyEmpty || !historyNotice || !clearHistory
		|| !themeSetting || !colorSetting || !colorValue || !resetTheme || !settingsNotice
		|| !resultActions || !shareButton || !shareFeedback || panels.some((panel) => !panel)) {
		throw new Error('The battle page is missing required elements.');
	}
	const panelElements = panels as HTMLElement[];
	const closeSuggestions = players.map((player) => setupUsernameAutocomplete(player.input));
	for (const panel of panelElements) {
		panel.addEventListener('focusin', (event) => {
			const item = (event.target as Element).closest('.xmb-item');
			if (!item) return;
			panel.querySelector('[data-selected]')?.removeAttribute('data-selected');
			item.setAttribute('data-selected', 'true');
		});
		panel.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)
				|| event.target.closest('input, select, button, label, a, .contribution-graph')) return;
			const item = event.target.closest('.xmb-item');
			const target = item && itemTarget(item);
			if (target && target !== document.activeElement) {
				target.focus();
				sounds.play('move');
			}
		});
	}

	const contributionsLabel = (count: number) =>
		`${numberFormat.format(count)} ${count === 1 ? 'contribution' : 'contributions'}`;
	const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, reducedMotion.matches ? 0 : ms));

	function createGraph(data: PlayerResult): HTMLTableElement {
		const table = document.createElement('table');
		const caption = table.createCaption();
		caption.className = 'sr-only';
		caption.textContent = `${data.username}'s daily GitHub contributions, with weeks from left to right.`;
		const body = table.createTBody();
		const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
		contributionRows(data.weeks).forEach((days, weekday) => {
			const row = body.insertRow();
			const heading = document.createElement('th');
			heading.scope = 'row';
			const label = document.createElement('span');
			label.className = 'sr-only';
			label.textContent = weekdays[weekday]!;
			heading.append(label);
			row.append(heading);
			days.forEach((day, column) => {
				const cell = row.insertCell();
				cell.style.setProperty('--col', String(column));
				if (!day) return;
				const square = document.createElement('span');
				square.className = 'contribution-day';
				square.style.backgroundColor = day.color;
				square.dataset.date = day.date;
				square.dataset.count = String(day.count);
				const text = document.createElement('span');
				text.className = 'sr-only';
				text.textContent = `${day.date}: ${contributionsLabel(day.count)}`;
				square.append(text);
				cell.append(square);
			});
		});
		return table;
	}

	// Tooltip: one shared element, positioned next to the hovered or tapped square.
	let activeSquare: HTMLElement | undefined;
	function hideTooltip() {
		tooltip!.hidden = true;
		activeSquare?.classList.remove('is-active');
		activeSquare = undefined;
	}
	function showTooltip(square: HTMLElement) {
		const date = square.dataset.date;
		const count = Number(square.dataset.count);
		if (!date || !Number.isFinite(count)) return;
		activeSquare?.classList.remove('is-active');
		activeSquare = square;
		square.classList.add('is-active');
		const strong = document.createElement('strong');
		strong.textContent = contributionsLabel(count);
		const when = document.createElement('span');
		when.textContent = tooltipDate.format(new Date(`${date}T00:00:00Z`));
		tooltip!.replaceChildren(strong, when);
		tooltip!.hidden = false;
		const box = square.getBoundingClientRect();
		const tip = tooltip!.getBoundingClientRect();
		const left = Math.min(Math.max(8, box.left + box.width / 2 - tip.width / 2), innerWidth - tip.width - 8);
		let top = box.top - tip.height - 10;
		if (top < 8) top = box.bottom + 10;
		tooltip!.style.left = `${left}px`;
		tooltip!.style.top = `${top}px`;
	}
	for (const player of players) {
		const squareFrom = (event: Event) =>
			(event.target as Element | null)?.closest<HTMLElement>('.contribution-day') ?? undefined;
		player.graph.addEventListener('pointerover', (event) => {
			const square = squareFrom(event);
			if (square) showTooltip(square);
		});
		player.graph.addEventListener('click', (event) => {
			const square = squareFrom(event);
			if (square) showTooltip(square);
		});
		player.graph.addEventListener('pointerleave', (event) => {
			if (event.pointerType === 'mouse') hideTooltip();
		});
		player.graph.addEventListener('scroll', hideTooltip, { passive: true });
	}
	document.addEventListener('pointerdown', (event) => {
		if (!(event.target as Element | null)?.closest('.contribution-day')) hideTooltip();
	});
	addEventListener('resize', hideTooltip);

	// XMB navigation: horizontal categories, vertical items.
	function selectTab(index: number, { focus = true, sound = true } = {}) {
		const next = Math.max(0, Math.min(tabs.length - 1, index));
		if (next === activeTab) {
			if (focus) tabs[next]!.focus();
			return;
		}
		const direction = next > activeTab ? 'next' : 'prev';
		tabs.forEach((tab, tabIndex) => {
			const selected = tabIndex === next;
			tab.setAttribute('aria-selected', String(selected));
			tab.tabIndex = selected ? 0 : -1;
			panelElements[tabIndex]!.hidden = !selected;
		});
		const panel = panelElements[next]!;
		panel.dataset.enter = direction;
		panel.classList.remove('is-entering');
		void panel.offsetWidth;
		panel.classList.add('is-entering');
		track!.style.setProperty('--active', String(next));
		activeTab = next;
		hideTooltip();
		if (sound) sounds.play('category');
		if (focus) tabs[next]!.focus();
	}

	function itemTarget(item: Element) {
		return item.querySelector<HTMLElement>('input:not([disabled]), select:not([disabled]), button:not([disabled]), [tabindex="0"]');
	}

	function moveItem(delta: number) {
		const items = [...panelElements[activeTab]!.querySelectorAll<HTMLElement>('.xmb-item')]
			.filter((item) => !item.closest('[hidden]') && itemTarget(item));
		if (!items.length) return;
		const current = items.findIndex((item) => item.contains(document.activeElement));
		const next = current === -1 ? (delta > 0 ? 0 : -1) : current + delta;
		if (next < 0) {
			if (current !== -1) {
				tabs[activeTab]!.focus();
				sounds.play('move');
			}
			return;
		}
		if (next >= items.length) return;
		itemTarget(items[next]!)!.focus();
		items[next]!.scrollIntoView({ block: 'nearest', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
		sounds.play('move');
	}

	tabs.forEach((tab, index) => tab.addEventListener('click', () => selectTab(index)));

	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
		const target = event.target instanceof HTMLElement ? event.target : document.body;
		const isInput = target instanceof HTMLInputElement;
		const isText = isInput && target.type === 'text';
		const isRange = isInput && target.type === 'range';
		const isCheckbox = isInput && target.type === 'checkbox';
		if (target instanceof HTMLSelectElement || (isInput && target.type === 'color')) return;
		const onTab = target.getAttribute('role') === 'tab';
		const inGraph = Boolean(target.closest('.contribution-graph'));

		switch (event.key) {
			case 'ArrowLeft':
			case 'ArrowRight':
				if (isText || isRange || inGraph) return;
				event.preventDefault();
				selectTab(activeTab + (event.key === 'ArrowRight' ? 1 : -1));
				return;
			case 'ArrowUp':
			case 'ArrowDown':
				event.preventDefault();
				moveItem(event.key === 'ArrowDown' ? 1 : -1);
				return;
			case 'Enter':
				if (onTab) {
					event.preventDefault();
					sounds.play('confirm');
					moveItem(1);
				} else if (isCheckbox) {
					event.preventDefault();
					target.click();
				}
				return;
			case 'Escape':
			case 'Backspace':
				if (event.key === 'Backspace' && isText) return;
				if (!tooltip.hidden) {
					hideTooltip();
					if (event.key === 'Escape') return;
				}
				event.preventDefault();
				if (onTab) {
					if (activeTab !== 0) selectTab(0, { sound: false });
				} else {
					tabs[activeTab]!.focus();
				}
				sounds.play('back');
		}
	});

	let swipe: { x: number; y: number } | undefined;
	const screen = document.querySelector<HTMLElement>('.screen-content');
	screen?.addEventListener('pointerdown', (event) => {
		const target = event.target as Element;
		swipe = event.pointerType === 'mouse' || target.closest('.contribution-graph, input, select')
			? undefined : { x: event.clientX, y: event.clientY };
	});
	screen?.addEventListener('pointerup', (event) => {
		if (!swipe) return;
		const dx = event.clientX - swipe.x;
		const dy = event.clientY - swipe.y;
		swipe = undefined;
		if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
			selectTab(activeTab + (dx < 0 ? 1 : -1), { focus: false });
		}
	});

	// Settings and sound effects (audio starts only after a user gesture).
	function applySettings(persist: boolean) {
		sounds.setEnabled(settings.sound);
		sounds.setVolume(settings.volume);
		soundSetting!.checked = settings.sound;
		soundQuick!.setAttribute('aria-pressed', String(settings.sound));
		volumeSetting!.value = String(Math.round(settings.volume * 100));
		volumeSetting!.setAttribute('aria-valuetext', `${Math.round(settings.volume * 100)}%`);
		bootSetting!.checked = settings.boot;
		document.documentElement.style.setProperty('--theme-color', settings.themeColor);
		document.querySelector('meta[name="theme-color"]')?.setAttribute('content', settings.themeColor);
		themeSetting!.value = themePresets.some((theme) => theme.color === settings.themeColor)
			? settings.themeColor : 'custom';
		colorSetting!.value = settings.themeColor;
		colorValue!.value = settings.themeColor.toUpperCase();
		if (persist) {
			const saved = saveSettings(settings);
			settingsNotice!.hidden = saved;
			settingsNotice!.textContent = saved ? ''
				: 'Settings apply for now, but could not be saved. Check your browser storage permissions.';
		}
	}
	const unlock = () => sounds.unlock();
	document.addEventListener('pointerdown', unlock, true);
	document.addEventListener('keydown', unlock, true);
	soundSetting.addEventListener('change', () => {
		settings.sound = soundSetting.checked;
		applySettings(true);
		sounds.unlock();
		sounds.play('confirm');
	});
	soundQuick.addEventListener('click', () => {
		settings.sound = !settings.sound;
		applySettings(true);
		sounds.unlock();
		sounds.play('confirm');
	});
	volumeSetting.addEventListener('input', () => {
		settings.volume = Number(volumeSetting.value) / 100;
		applySettings(true);
	});
	volumeSetting.addEventListener('change', () => sounds.play('move'));
	bootSetting.addEventListener('change', () => {
		settings.boot = bootSetting.checked;
		applySettings(true);
		sounds.play('confirm');
	});
	themeSetting.addEventListener('change', () => {
		if (themeSetting.value === 'custom') {
			colorSetting.focus();
			return;
		}
		settings.themeColor = themeSetting.value;
		applySettings(true);
		sounds.play('confirm');
	});
	colorSetting.addEventListener('input', () => {
		settings.themeColor = colorSetting.value;
		applySettings(true);
	});
	resetTheme.addEventListener('click', () => {
		settings.themeColor = defaultSettings.themeColor;
		applySettings(true);
		sounds.play('confirm');
	});
	applySettings(false);

	// Persist summaries only; contribution grids remain in the API cache.
	const historyDate = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
	function renderHistory() {
		historyList!.replaceChildren();
		historyEmpty!.hidden = history.length !== 0;
		clearHistory!.hidden = history.length === 0;
		for (const battle of history) {
			const item = document.createElement('li');
			item.className = 'xmb-item history-entry';
			const body = document.createElement('div');
			body.className = 'item-body';
			const title = document.createElement('h3');
			title.textContent = `${battle.players[0].username} vs ${battle.players[1].username}`;
			const time = document.createElement('time');
			time.dateTime = battle.playedAt;
			time.textContent = historyDate.format(new Date(battle.playedAt));
			time.className = 'help';
			const totals = document.createElement('p');
			totals.className = 'history-totals';
			totals.textContent = battle.players.map((player) =>
				`${player.username}: ${contributionsLabel(player.totalContributions)}`).join(' / ');
			const outcome = battleOutcome([battle.players[0].totalContributions, battle.players[1].totalContributions]);
			const verdict = document.createElement('p');
			verdict.className = 'history-verdict';
			verdict.textContent = outcome.winner === null ? 'Draw'
				: `${battle.players[outcome.winner].username} wins by ${contributionsLabel(outcome.margin)}.`;
			const replay = document.createElement('button');
			replay.type = 'button';
			replay.className = 'menu-button';
			replay.textContent = 'Use players';
			replay.setAttribute('aria-label', `Use players ${battle.players[0].username} and ${battle.players[1].username}`);
			replay.addEventListener('click', () => {
				if (loading) {
					historyNotice!.textContent = 'Wait for the current battle to finish before choosing players.';
					historyNotice!.hidden = false;
					return;
				}
				players.forEach((player, index) => {
					player.input.value = battle.players[index]!.username;
					player.input.removeAttribute('aria-invalid');
					player.error.hidden = true;
				});
				selectTab(0);
				button!.focus();
			});
			body.append(time, title, totals, verdict);
			item.append(body, replay);
			historyList!.append(item);
		}
	}
	function persistHistory() {
		try {
			localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
			historyNotice!.hidden = true;
		} catch (error) {
			console.warn('Unable to save battle history.', error);
			historyNotice!.textContent = 'History could not be saved. Changes are available only until you reload.';
			historyNotice!.hidden = false;
		}
	}
	try {
		history = parseHistory(localStorage.getItem(HISTORY_KEY));
	} catch (error) {
		console.warn('Unable to load battle history.', error);
		historyNotice.textContent = 'Saved history could not be loaded. New battles will start a fresh history.';
		historyNotice.hidden = false;
	}
	renderHistory();
	clearHistory.addEventListener('click', () => {
		if (!confirm('Clear all battle history saved in this browser?')) return;
		history = [];
		persistHistory();
		renderHistory();
		tabs[activeTab]!.focus();
	});

	shareButton.addEventListener('click', async () => {
		const battle = currentBattle;
		if (!battle || shareButton.disabled) return;
		clearTimeout(copyTimer);
		shareButton.disabled = true;
		shareFeedback.textContent = '';
		shareFeedback.classList.remove('error');
		const canCopy = typeof navigator.clipboard?.writeText === 'function';
		try {
			if (!canCopy) {
				throw new Error('Clipboard access is unavailable. Open this page over HTTPS or localhost and try again.');
			}
			await navigator.clipboard.writeText(formatBattleSummary(battle));
			if (currentBattle !== battle) return;
			shareFeedback.textContent = 'Copied to clipboard!';
			sounds.play('confirm');
			copyTimer = setTimeout(() => { shareFeedback.textContent = ''; }, 2500);
		} catch (error) {
			if (currentBattle !== battle) return;
			console.warn('Unable to copy battle results.', error);
			shareFeedback.textContent = canCopy
				? 'Unable to copy. Allow clipboard access in your browser and try again.'
				: 'Clipboard access is unavailable. Use HTTPS or localhost and try again.';
			shareFeedback.classList.add('error');
		} finally {
			shareButton.disabled = false;
		}
	});

	const clockFormat = new Intl.DateTimeFormat(undefined, {
		month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit',
	});
	const tick = () => { clock.textContent = clockFormat.format(new Date()); };
	tick();
	setInterval(tick, 15_000);

	function countUp(element: HTMLElement, value: number, duration: number) {
		if (reducedMotion.matches || value === 0) {
			element.textContent = numberFormat.format(value);
			return Promise.resolve();
		}
		return new Promise<void>((resolve) => {
			const start = performance.now();
			const step = (now: number) => {
				const progress = Math.min(1, (now - start) / duration);
				element.textContent = numberFormat.format(Math.round(value * (1 - (1 - progress) ** 3)));
				if (progress < 1) requestAnimationFrame(step);
				else resolve();
			};
			requestAnimationFrame(step);
		});
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (loading) return;

		currentBattle = undefined;
		closeSuggestions.forEach((close) => close());
		resultActions.hidden = true;
		clearTimeout(copyTimer);
		shareFeedback.textContent = '';
		hideTooltip();
		content.hidden = true;
		content.classList.remove('is-revealing');
		outcomeText.hidden = true;
		graphHelp.hidden = true;
		empty.hidden = true;
		status.textContent = '';
		const usernames = players.map((player) => player.input.value.trim());
		let firstInvalid: HTMLInputElement | undefined;
		players.forEach((player, index) => {
			const input = player.input;
			const error = player.error;
			const username = usernames[index]!;
			input.value = username;
			error.hidden = true;
			error.textContent = '';
			input.removeAttribute('aria-invalid');
			player.card.classList.remove('is-winner', 'is-defeated');
			player.badge.hidden = true;
			if (!username || username.length > 39
				|| username.match(/^[a-z\d]+(?:-[a-z\d]+)*$/i)?.[0] !== username) {
				error.textContent = !username ? 'Enter a GitHub username.'
					: 'Use 1-39 letters, digits or single hyphens, with no leading or trailing hyphen.';
				error.hidden = false;
				input.setAttribute('aria-invalid', 'true');
				firstInvalid ??= input;
			}
		});
		if (firstInvalid) {
			empty.hidden = false;
			status.textContent = 'Check the highlighted usernames.';
			sounds.play('error');
			firstInvalid.focus();
			return;
		}

		loading = true;
		let focusAfter: HTMLElement | undefined;
		button.disabled = true;
		players.forEach((player) => { player.input.disabled = true; });
		form.classList.add('is-loading');
		results.setAttribute('aria-busy', 'true');
		loadingView.hidden = false;
		status.textContent = 'Loading contributions...';
		sounds.play('confirm');
		selectTab(1, { focus: false, sound: false });

		try {
			const outcomes = await Promise.allSettled(usernames.map(loadPlayer));
			let failed = false;
			outcomes.forEach((outcome, index) => {
				if (outcome.status === 'rejected') {
					failed = true;
					const player = players[index]!;
					player.error.textContent = outcome.reason instanceof Error
						? outcome.reason.message : 'Unable to load contributions. Please try again.';
					player.error.hidden = false;
					player.input.setAttribute('aria-invalid', 'true');
					focusAfter ??= player.input;
				}
			});
			if (failed) {
				loadingView.hidden = true;
				empty.hidden = false;
				status.textContent = 'Comparison failed. Check the player errors and try again.';
				sounds.play('error');
				selectTab(0, { focus: false, sound: false });
				return;
			}

			const data = outcomes.map((outcome) => (outcome as PromiseFulfilledResult<PlayerResult>).value);
			data.forEach((result, index) => {
				const player = players[index]!;
				player.username.textContent = result.username;
				player.total.textContent = '0';
				player.period.textContent = `${dateFormat.format(new Date(`${result.from}T00:00:00Z`))} to ${dateFormat.format(new Date(`${result.to}T00:00:00Z`))}`;
				player.graph.replaceChildren(createGraph(result));
				player.graph.setAttribute('aria-label', `${result.username}'s contribution graph`);
			});

			loadingView.hidden = true;
			content.hidden = false;
			void content.offsetWidth;
			content.classList.add('is-revealing');
			await wait(700);
			await Promise.all(data.map((result, index) =>
				countUp(players[index]!.total, result.totalContributions, 1400)));
			await wait(400);

			const result = battleOutcome([data[0]!.totalContributions, data[1]!.totalContributions]);
			const message = result.winner === null
				? `Draw: both players have ${contributionsLabel(data[0]!.totalContributions)}.`
				: `${data[result.winner]!.username} wins by ${contributionsLabel(result.margin)}.`;
			players.forEach((player, index) => {
				player.card.classList.toggle('is-winner', result.winner === index);
				player.card.classList.toggle('is-defeated', result.winner !== null && result.winner !== index);
				player.badge.hidden = result.winner !== index;
			});
			outcomeText.textContent = message;
			outcomeText.hidden = false;
			graphHelp.hidden = false;
			currentBattle = {
				playedAt: new Date().toISOString(),
				players: [
					{ username: data[0]!.username, totalContributions: data[0]!.totalContributions },
					{ username: data[1]!.username, totalContributions: data[1]!.totalContributions },
				],
			};
			history = prependBattle(history, currentBattle);
			persistHistory();
			renderHistory();
			resultActions.hidden = false;
			sounds.play('reveal');
			status.textContent = `Contributions loaded for both players. ${message}`;
			focusAfter = tabs[1];
		} catch (error) {
			console.error('Unable to display the battle results.', error);
			loadingView.hidden = true;
			content.hidden = true;
			empty.hidden = false;
			status.textContent = 'Unable to display results. Please try again.';
			sounds.play('error');
		} finally {
			loading = false;
			button.disabled = false;
			players.forEach((player) => { player.input.disabled = false; });
			form.classList.remove('is-loading');
			results.setAttribute('aria-busy', 'false');
			focusAfter?.focus();
		}
	});
</script>

<style>
	:global(:root) {
		color-scheme: dark;
		font-family: "Helvetica Neue", Helvetica, Arial, "Segoe UI", system-ui, sans-serif;
		--text: #f7f9fc;
		--theme-color: #337ac0;
		/* Fixed lightness keeps every hue readable, including very bright custom colors. */
		--theme-top: oklch(from var(--theme-color) 0.49 min(c, 0.14) h);
		--theme-mid: oklch(from var(--theme-color) 0.43 min(c, 0.12) h);
		--theme-bottom: oklch(from var(--theme-color) 0.31 min(c, 0.1) h);
		--theme-shadow: oklch(from var(--theme-color) 0.23 min(c, 0.055) h);
		--theme-light: oklch(from var(--theme-color) 0.94 min(c, 0.025) h);
		--muted: color-mix(in srgb, var(--theme-light) 90%, var(--text));
		--glass: color-mix(in srgb, var(--theme-shadow) 34%, transparent);
		--glass-strong: color-mix(in srgb, var(--theme-shadow) 50%, transparent);
		--line: rgba(255, 255, 255, 0.22);
		--highlight: rgba(255, 255, 255, 0.14);
		--error: #ffd6d6;
		--ease: cubic-bezier(0.22, 0.8, 0.2, 1);
		--anchor: clamp(1rem, 12vw, 9rem);
		--category: 8rem;
		--icon: 3rem;
	}
	:global(*) { box-sizing: border-box; }
	:global(body) {
		margin: 0;
		min-height: 100dvh;
		background: var(--theme-shadow);
		color: var(--text);
		line-height: 1.5;
	}
	[hidden] { display: none !important; }

	/* Optional handheld bezel (desktop only); content stays fully usable on mobile. */
	.handheld {
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: 1.5rem;
	}
	.screen {
		position: relative;
		width: min(100%, 78rem);
		height: calc(100dvh - 3rem);
		min-height: 34rem;
		overflow: hidden;
		border-radius: 0.75rem;
		background:
			radial-gradient(ellipse at 65% 15%, color-mix(in srgb, var(--theme-light) 10%, transparent), transparent 65%),
			linear-gradient(180deg, var(--theme-top) 0%, var(--theme-mid) 42%, var(--theme-bottom) 100%);
		box-shadow:
			0 0 0 1.25rem #1b1d21,
			0 0 0 1.4rem #3a3e45,
			0 2rem 4rem color-mix(in srgb, var(--theme-shadow) 45%, transparent);
	}
	.screen-content {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow-y: auto;
		padding: 1rem 0 0;
	}
	.screen[data-booting] .screen-content {
		opacity: 0;
		transform: translateY(0.5rem);
	}
	.screen.is-boot-revealing .screen-content {
		animation: menu-reveal 0.6s var(--ease) both;
	}
	@keyframes menu-reveal {
		from { opacity: 0; transform: translateY(0.5rem); }
		to { opacity: 1; transform: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.screen.is-boot-revealing .screen-content { animation: none; }
	}
	main { flex: 1 0 auto; padding-bottom: 1.5rem; }

	.system-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0 1.25rem 0 var(--anchor);
		font-size: 0.8125rem;
	}
	h1 { margin: 0; font-size: 0.9375rem; font-weight: 400; letter-spacing: 0.02em; }
	.subtitle { margin-left: 0.5rem; color: var(--muted); font-weight: 300; }
	.system-info { display: flex; align-items: center; gap: 0.75rem; font-variant-numeric: tabular-nums; }
	.sound-quick {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--text);
		cursor: pointer;
	}
	.sound-quick :global(.xmb-glyph) { width: 1.25rem; height: 1.25rem; }
	.sound-quick :global(.sound-off) { display: none; }
	.sound-quick[aria-pressed="false"] :global(.sound-wave) { display: none; }
	.sound-quick[aria-pressed="false"] :global(.sound-off) { display: inline-flex; }
	.sound-quick:hover { background: var(--highlight); }

	/* Category bar: the active category stays anchored, the bar slides. */
	.xmb-bar { margin-top: clamp(1.5rem, 6vh, 3.5rem); overflow: hidden; padding: 1rem 0 0.75rem; }
	.xmb-track {
		--active: 0;
		display: flex;
		padding-left: var(--anchor);
		transform: translateX(calc(var(--active) * -1 * var(--category)));
		transition: transform 0.45s var(--ease);
